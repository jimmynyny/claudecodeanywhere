{
  "name": "claudecodeanywhere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Menu bar app + agent that turns your Macs into your personal Claude Code cloud via an always-on Orchestrator session",
  "scripts": {
    "agent": "node packages/agent/src/main.ts",
    "dev": "scripts/dev/run.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "install:agent": "scripts/install-agent.sh",
    "uninstall:agent": "scripts/uninstall-agent.sh"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
